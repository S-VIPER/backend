                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"trackId\": \"track001\"\n}"
            },
            "description": "Добавить трек в плейлист"
          },
          "response": []
        },
        {
          "name": "Remove Track From Playlist",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "http://localhost/api/v1/playlists/playlist001/tracks/track001",
